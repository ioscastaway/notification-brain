<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Our own "N tidied today" summary notification (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Only the Rules tab uses the network: the sentence you typed and the list of app labels,
        packages and channel ids go to the model so it can name the right app. Notification bodies
        never leave the device.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (API 30+): launcher apps only, so a typed rule can name an app by label. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotificationBrain">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The core of the experiment. NotificationManagerService binds this once the user grants
            notification access in Settings > Notifications > Device & app notifications. It cannot
            be enabled from code. The same binding lets the app read every notification and cancel
            the ones the policy decides against.
        -->
        <service
            android:name=".platform.BrainNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
